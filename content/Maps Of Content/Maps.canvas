		{"id":"c3e9dfe87488d299","type":"text","text":"## [[_Main Page.canvas|Main Page]]","x":-1395,"y":-951,"width":200,"height":99},
		{"id":"0238e916c8d49c9d","type":"file","file":"Media/Cold Haven.png","x":727,"y":1378,"width":395,"height":400},
		{
			"id":"d048507177956d25",
			"type":"text",
			"text":"## Cold Haven 4P\n*The frost-choked manufactorum offers scant shelter from snow, cold or the weapons of any enemy who would claim it for their own.*",
			"styleAttributes":{},
			"x":1121,
			"y":1378,
			"width":367,
			"height":400
		},
		{
			"id":"e4190b8a3437a5e1",
			"type":"text",
			"text":"## Sinking City 2P\n*The remains of a once great manufactorum stands amidst a polluted swamp that will one day swallow it and leave only corroded iron bones to mark where it stood.*",
			"styleAttributes":{},
			"x":-107,
			"y":2302,
			"width":260,
			"height":400
		}
	],
